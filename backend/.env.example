PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webstudio
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
# Explicit runtime mode. Demo does not connect to PostgreSQL.
WEBHIVE_MODE=live
# Set to 1 only behind one trusted reverse proxy; omit for direct local access.
# TRUST_PROXY_HOPS=1
